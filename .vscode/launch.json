{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension (vscode-vitu)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/vscode-vitu",
				"${workspaceFolder}/vscode-vitu/example",
				"${workspaceFolder}/vscode-vitu/example/App.jsx"
			]
		},
		{
			"name": "Run Tests (vscode-vitu)",
			"type": "node",
			"request": "launch",
			"runtimeArgs": ["--test"],
			"program": "${workspaceFolder}/vscode-vitu/test/diagnostics.test.js",
			"cwd": "${workspaceFolder}/vscode-vitu",
			"console": "integratedTerminal"
		}
	]
}
