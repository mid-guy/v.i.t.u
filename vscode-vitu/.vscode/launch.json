{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/example/App.jsx"
			]
		},
		{
			"name": "Debug Tests",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/test/run.js",
			"skipFiles": ["<node_internals>/**"]
		}
	]
}
