{
	"name": "vitu-language-features",
	"displayName": "V.I.T.U Language Features",
	"description": "IntelliSense and error checking for the V.I.T.U directives (r-if, r-else, r-show, r-for) in JSX/TSX.",
	"version": "0.1.0",
	"publisher": "mid-guy",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Programming Languages"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:javascriptreact",
		"onLanguage:typescriptreact",
		"onLanguage:javascript",
		"onLanguage:typescript"
	],
	"contributes": {
		"typescriptServerPlugins": [
			{
				"name": "typescript-vitu-plugin",
				"enableForWorkspaceTypeScriptVersions": true
			}
		],
		"grammars": [
			{
				"scopeName": "vitu.directives.injection",
				"path": "./syntaxes/vitu-directives.tmLanguage.json",
				"injectTo": [
					"source.js",
					"source.js.jsx",
					"source.tsx"
				]
			}
		],
		"configurationDefaults": {
			"[javascriptreact]": {
				"editor.quickSuggestions": {
					"strings": "on"
				}
			},
			"[typescriptreact]": {
				"editor.quickSuggestions": {
					"strings": "on"
				}
			}
		}
	},
	"scripts": {
		"test": "node --test test/*.test.js",
		"test:debug": "node --inspect-brk --test test/*.test.js"
	},
	"dependencies": {
		"typescript": "^5.5.0",
		"typescript-vitu-plugin": "link:typescript-vitu-plugin"
	},
	"devDependencies": {
		"@types/react": "^19.2.17",
		"react": "^19.2.7"
	}
}
